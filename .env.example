# Copy to .env. Without a key the app runs in offline mode (recorded responses + manual editor).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=anthropic | replay   (defaults to anthropic when a key is set)
# RECORD_FIXTURES=1                 save live responses for offline replay
# LLM_TIMEOUT_S=20
# PROFILE_ROWS=200000
# PORT=8000
# OUTCOME_TOKEN=                  shared secret the campaign tool sends (X-Outcome-Token) to report outcomes
